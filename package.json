{
  "name": "@vantran-se/ompweb",
  "version": "0.6.0",
  "description": "Web UI for the oh-my-pi (omp) coding agent",
  "homepage": "https://github.com/vantran-se/ompweb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vantran-se/ompweb.git"
  },
  "bugs": {
    "url": "https://github.com/vantran-se/ompweb/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "bin": {
    "ompweb": "bin/omp-web.js",
    "ompweb-tray": "bin/omp-web-tray.js",
    "ompweb-tray-linux": "bin/linux-tray.js",
    "ompweb-launchd": "bin/omp-web-launchd.js",
    "ompweb-systemd": "bin/omp-web-systemd.js"
  },
  "files": [
    "bin",
    "lib",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/diagnostics",
    "!.next/types",
    "!.next/trace",
    "!.next/trace-build",
    "!.next/**/*.map",
    "public",
    "scripts",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 30178",
    "dev:lan": "next dev -H 0.0.0.0 -p 30178",
    "build": "next build --webpack",
    "build:bun": "bun run next build --webpack",
    "start": "next start -H 127.0.0.1 -p 30177",
    "start:lan": "next start -H 0.0.0.0 -p 30177",
    "test": "node --experimental-strip-types --test lib/*.test.mjs lib/omp/*.test.mjs components/*.test.mjs components/ui/*.test.mjs hooks/*.test.mjs bin/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "tray:install": "node bin/omp-web-tray.js --install",
    "tray:uninstall": "node bin/omp-web-tray.js --uninstall",
    "tray:start": "node bin/omp-web-tray.js --start",
    "tray:status": "node bin/omp-web-tray.js --status",
    "systemd:install": "node bin/omp-web-systemd.js install",
    "systemd:uninstall": "node bin/omp-web-systemd.js uninstall",
    "systemd:start": "node bin/omp-web-systemd.js start",
    "systemd:stop": "node bin/omp-web-systemd.js stop",
    "systemd:status": "node bin/omp-web-systemd.js status",
    "prepack": "npm run build",
    "release:check": "npm run typecheck && npm run lint && npm test && npm run build",
    "build:node": "next build --webpack"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "cmdk": "^1.1.1",
    "dbus-next": "^0.10.2",
    "jiti": "^2.7.0",
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.12.3",
    "mdast-util-find-and-replace": "^3.0.2",
    "mermaid": "^12.0.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "undici": "^8.11.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.1",
    "typescript-language-server": "^6.0.0"
  },
  "packageManager": "npm@12.1.0",
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "dbus-next": {
      "usocket": "$usocket"
    },
    "lodash-es": "4.18.1",
    "form-data": "4.0.6",
    "qs": "6.16.0",
    "tough-cookie": "6.0.2",
    "tar": "7.5.22",
    "xml2js": "0.6.2"
  },
  "optionalDependencies": {
    "usocket": "0.3.0"
  }
}
